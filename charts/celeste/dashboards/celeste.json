      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({namespace=\"$namespace\", container=\"bot\"} | json | level >= 50 [1h])) or vector(0)",
